; ============================================================
; Flappy Clone - Godot 项目配置
; ============================================================
; 这个文件是 Godot 项目的入口配置，记录了：
;   - 项目名称、描述、主场景
;   - 渲染器与窗口设置
;   - 自定义输入动作（这里先用默认 ui_accept）
;
; 你不需要手动编辑此文件，Godot 编辑器中的
;   Project → Project Settings 菜单会自动管理它。
; 但了解其结构对排查问题很有帮助。

config_version=5

[application]

config/name="Flappy Clone"
config/description="My first Godot game - Flappy Bird clone (learning project)"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[display]

; 窗口与拉伸设置
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[input]

; 输入动作配置。
; 这里我们暂时复用 Godot 内置的 ui_accept（默认绑定空格/回车/手柄A）作为跳跃。
; 后续如果你想自定义专门的 "jump" 动作，可以在
;   Project → Project Settings → Input Map 里添加，
; 然后在 player.gd 里把 ui_accept 换成 jump。

[rendering]

; 使用 GL Compatibility 渲染器（基于 OpenGL），
; 兼容几乎所有显卡，适合 2D 学习项目。
; 如果你有独立显卡且想用更好的渲染器，
; 可以改为 "forward_plus"（需 Vulkan 支持）。
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
