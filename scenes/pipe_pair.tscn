; ============================================================
; pipe_pair.tscn - 管道对场景
; ============================================================
; 结构：
;   PipePair (Node2D, 挂 pipe_pair.gd)
;   ├── TopPipe (Area2D, 碰撞+死亡) position=(0,-440)
;   │   ├── Sprite (Polygon2D, 80x720 绿色)
;   │   └── CollisionShape2D (RectangleShape2D 80x720)
;   ├── BottomPipe (Area2D, 碰撞+死亡) position=(0,+440)
;   │   ├── Sprite (Polygon2D, 80x720 绿色)
;   │   └── CollisionShape2D (RectangleShape2D 80x720)
;   └── PassDetector (Area2D, 计分) position=(0,0) ← Step 4 新增
;       └── CollisionShape2D (RectangleShape2D 10x160, 覆盖缺口)
;
; Step 4 新增 PassDetector：
;   - 一个细长 Area2D (10 宽 x 160 高 = 缺口高度)
;   - 放在缺口中心，玩家穿过缺口时触发 body_entered
;   - 触发后发出 player_passed 信号，main.gd 加分
;   - 与 TopPipe/BottomPipe 的 player_hit 互斥（玩家要么撞管，要么穿过）

[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/pipe_pair.gd" id="1_pipe_pair_script"]

[sub_resource type="RectangleShape2D" id="RectangleShape2D_pipe"]
size = Vector2(80, 720)

[sub_resource type="RectangleShape2D" id="RectangleShape2D_pass"]
size = Vector2(10, 160)

[node name="PipePair" type="Node2D"]
script = ExtResource("1_pipe_pair_script")

[node name="TopPipe" type="Area2D" parent="."]
position = Vector2(0, -440)

[node name="Sprite" type="Polygon2D" parent="TopPipe"]
polygon = PackedVector2Array(-40, -360, 40, -360, 40, 360, -40, 360)
color = Color(0.2, 0.7, 0.2, 1)

[node name="CollisionShape2D" type="CollisionShape2D" parent="TopPipe"]
shape = SubResource("RectangleShape2D_pipe")

[node name="BottomPipe" type="Area2D" parent="."]
position = Vector2(0, 440)

[node name="Sprite" type="Polygon2D" parent="BottomPipe"]
polygon = PackedVector2Array(-40, -360, 40, -360, 40, 360, -40, 360)
color = Color(0.2, 0.7, 0.2, 1)

[node name="CollisionShape2D" type="CollisionShape2D" parent="BottomPipe"]
shape = SubResource("RectangleShape2D_pipe")

[node name="PassDetector" type="Area2D" parent="."]

[node name="CollisionShape2D" type="CollisionShape2D" parent="PassDetector"]
shape = SubResource("RectangleShape2D_pass")
