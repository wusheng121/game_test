; ============================================================
; player.tscn - 小鸟场景
; ============================================================
; 这个场景定义了"小鸟"长什么样、有什么物理属性。
; 后续在 main.tscn 中作为子节点实例化使用。

[gd_scene load_steps=3 format=3]

; 外部资源引用：把 scripts/player.gd 挂到根节点上
[ext_resource type="Script" path="res://scripts/player.gd" id="1_player_script"]

; 子资源：碰撞形状（RectangleShape2D，32x32 正方形）
; size 单位是像素
[sub_resource type="RectangleShape2D" id="RectangleShape2D_player"]
size = Vector2(32, 32)

; 根节点：CharacterBody2D（可控物理角色）
; 挂载 player.gd 脚本
[node name="Player" type="CharacterBody2D"]
script = ExtResource("1_player_script")

; 视觉：用 Polygon2D 画一个 32x32 黄色方块
; 为什么用 Polygon2D 而不是 Sprite2D？
;   - Polygon2D 是 Node2D 的子类，会跟随父节点变换
;   - 不需要外部贴图，便于 Step 1 专注学物理
;   - Step 4 美术升级时可以替换为 Sprite2D + 像素图
; polygon 是顶点数组，这里定义了 4 个顶点形成正方形：
;   (-16,-16) 左上角
;   ( 16,-16) 右上角
;   ( 16, 16) 右下角
;   (-16, 16) 左下角
[node name="Sprite" type="Polygon2D" parent="."]
polygon = PackedVector2Array(-16, -16, 16, -16, 16, 16, -16, 16)
color = Color(1, 0.82, 0.18, 1)

; 碰撞体：RectangleShape2D，与 Sprite 同样大小
; 这是物理碰撞用，玩家撞墙/撞管道靠它判定
[node name="CollisionShape2D" type="CollisionShape2D" parent="."]
shape = SubResource("RectangleShape2D_player")
